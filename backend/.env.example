# --- Core --------------------------------------------------------------------
ENVIRONMENT=development                      # production refuses dev secrets, sandbox mode and test payments
DATABASE_URL=postgresql+psycopg://marketingos:marketingos@localhost:5432/marketingos
REDIS_URL=redis://localhost:6379/0            # optional: shared rate limiting across API replicas
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=change-me-too           # encrypts integration tokens at rest
WEB_ORIGIN=http://localhost:3000              # CORS origin(s), comma separated
PUBLIC_API_URL=http://localhost:8000          # must be publicly reachable for Instagram media and OAuth callbacks
AUTO_CREATE_TABLES=true                       # false when you run `alembic upgrade head` yourself
STORAGE_DIR=./storage

# --- AI ----------------------------------------------------------------------
AI_PROVIDER=offline                           # offline (templates, no cost) | openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_SEARCH_MODEL=gpt-4.1-mini              # GEO monitoring via the Responses API web_search tool
PERPLEXITY_API_KEY=                           # GEO monitoring via the Sonar API

# --- Meta (Instagram publishing + Marketing API) --------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- Google (Ads, Search Console, GA4, sign-in) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
PAGESPEED_API_KEY=                            # optional, raises the PageSpeed Insights quota

# --- Keyword data (used when Google Ads is not connected) -------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Sandbox connections (record actions locally; never enable in production) -
ALLOW_SANDBOX_INTEGRATIONS=true

# --- Payments (Razorpay, INR) -------------------------------------------------
PAYMENTS_MODE=test                            # test grants credits immediately | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email ---------------------------------------------------------------------
EMAIL_BACKEND=console                         # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MarketingOS <no-reply@example.com>
